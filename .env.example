# Copy to .env.local for development. In production set these in your host (Hoist) instead.

# Frontend only: backend service origin
BACKEND_URL=http://127.0.0.1:3401

# Set the same separate, random secret on BOTH services (32+ characters required in production).
# Never put this in a NEXT_PUBLIC_ variable.
MEDIAEX_API_TOKEN=

# Backend only: Renviq Postgres connection string in production
DATABASE_URL=postgres://mediaex:change-me@127.0.0.1:54340/mediaex

# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Backend only: public FRONTEND origin for auth cookies, email and OAuth callbacks
BETTER_AUTH_URL=http://localhost:3400

# Optional: real email through Resend. Without it, development emails go to /dev/mailbox
# and email verification is not required to sign in.
# RESEND_API_KEY=
# MAIL_FROM=MediaEX <hello@your-domain.com>

# Optional: social sign-in. Each button appears only when both values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Media (backend only)
# Where uploads and encoded files live. Default: local disk under MEDIA_DIR (./.media), fine for development.
# In production, uploads are refused unless a bucket (S3_*) or a persistent MEDIA_DIR volume is configured.
# MEDIA_DIR=.media
# For production, use an S3-compatible bucket instead (Cloudflare R2, AWS S3, MinIO…). Setting S3_BUCKET switches it on.
# The bucket needs a CORS rule allowing PUT from your app's origin, because browsers upload straight to it.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=mediaex
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Largest accepted upload in bytes (default 50 GiB). Files over 5 GiB, and the dashboard's from 64 MB, go up in parts.
# MAX_UPLOAD_BYTES=53687091200
# Encode on the GPU: nvenc (NVIDIA) or qsv (Intel). Needs an FFmpeg build with those encoders; falls back to the CPU.
# MEDIA_HW_ENCODER=nvenc
# The pipeline needs ffmpeg and ffprobe. Set these if they aren't on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Set to "off" on instances that should serve requests but not encode
# MEDIA_WORKER=off

# Optional (backend): lets workspaces turn on automatic image review in moderation
# ANTHROPIC_API_KEY=
# Cached transformation variants kept per asset (default 200)
# MAX_VARIANTS_PER_ASSET=200

# ---- Developer platform (backend only)
# Requests per minute allowed for each API key on /api/v1 (default 120)
# API_RATE_LIMIT_PER_MINUTE=120
# The origin API callers use, if it isn't BETTER_AUTH_URL (used in upload URLs given to key callers)
# PUBLIC_API_URL=https://mediaex.example.com

# ---- Captions (backend only)
# Turns on automatic captions with OpenAI Whisper (audio is sent to OpenAI)
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Billing (backend only). With neither provider configured, every workspace stays on Creator.
# BILLING_PROVIDER=stripe
# Stripe: webhook URL <BETTER_AUTH_URL>/api/billing/webhook/stripe (checkout.session.completed, customer.subscription.*, invoice.payment_failed)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Paystack: webhook URL <BETTER_AUTH_URL>/api/billing/webhook/paystack. Prices in PAYSTACK_CURRENCY's main unit.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CURRENCY=NGN
# PAYSTACK_PRICES=pro_month=36000,pro_year=342000,studio_month=150000,studio_year=1428000

# ---- Legal pages (frontend, read at build time)
# The address /terms and /privacy give for questions and data requests. Without it they ask people to reply to one of our emails.
# NEXT_PUBLIC_LEGAL_EMAIL=privacy@your-domain.com
