 /** The event's schedule, read-only, with places booked and session check-ins (GET /admin/events/:id/schedule). */
+function CoverHistory({id,changed}:{id:string;changed:()=>void}){
+  const history=useApi<{updatedAt:string;history:{id:string;imageUrl:string|null;createdAt:string}[]}>('/admin/events/'+id+'/cover-history')
+  const [busy,setBusy]=useState(false),[message,setMessage]=useState('')
+  async function restore(revision:string){
+    if(!history.data||busy)return
+    setBusy(true)
+    try {
+      await api('/admin/events/'+id+'/cover-history/'+revision+'/restore',{method:'POST',body:{expectedUpdatedAt:history.data.updatedAt}})
+      setMessage('Cover restored.');history.reload();changed()
+    } catch(e){setMessage(e instanceof Error?e.message:'Could not restore this cover.')}
+    finally{setBusy(false)}
+  }
+  return <div><strong>Cover history</strong>{history.error&&<p role="alert">{history.error}</p>}
+    {!history.data&&!history.error&&<p>Loading covers…</p>}
+    {history.data&&!history.data.history.length&&<p>No previous covers recorded.</p>}
+    {history.data?.history.map(row=><div key={row.id} className="flex items-center gap-3 py-2">
+      {row.imageUrl&&<img src={row.imageUrl} alt="Previous event cover" width={96} height={54}/>}
+      <time dateTime={row.createdAt}>{new Date(row.createdAt).toLocaleString()}</time>
+      <button className={ROW_BTN} type="button" disabled={busy} onClick={()=>void restore(row.id)}>Restore this cover</button></div>)}
+    {message&&<p role="status">{message}</p>}</div>
+}
 function AdminSchedule({ e }: { e: AdminEvent }) {
   const res = useApi<{ items: OrganizerItem[] }>(`/admin/events/${e.id}/schedule`);
   if (res.error) return <p className={`${CELL_SUB} m-0`}>{res.error}</p>;
