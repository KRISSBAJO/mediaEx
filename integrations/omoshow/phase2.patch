@@ -0,0 +1,20 @@
+CREATE TABLE omoshow_cover_sync ("eventId" text PRIMARY KEY, "retryAt" timestamptz NOT NULL DEFAULT now());
+CREATE TABLE omoshow_cover_history (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,"eventId" text NOT NULL REFERENCES "Event"(id) ON DELETE CASCADE,media jsonb,"imageUrl" text,"createdAt" timestamptz NOT NULL DEFAULT now());
+CREATE INDEX omoshow_cover_history_event ON omoshow_cover_history ("eventId",id DESC);
+CREATE FUNCTION omoshow_queue_cover() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='DELETE' THEN
+   INSERT INTO omoshow_cover_sync ("eventId") VALUES (OLD.id) ON CONFLICT ("eventId") DO UPDATE SET "retryAt"=now();
+   RETURN OLD;
+ END IF;
+ IF OLD.media IS DISTINCT FROM NEW.media OR OLD."imageUrl" IS DISTINCT FROM NEW."imageUrl" THEN
+   IF OLD.status='PUBLISHED' THEN
+     INSERT INTO omoshow_cover_history ("eventId",media,"imageUrl") VALUES(OLD.id,OLD.media,OLD."imageUrl");
+   END IF;
+ END IF;
+ IF OLD.media IS DISTINCT FROM NEW.media OR OLD.status IS DISTINCT FROM NEW.status OR OLD."imageUrl" IS DISTINCT FROM NEW."imageUrl" THEN
+   INSERT INTO omoshow_cover_sync ("eventId") VALUES(NEW.id) ON CONFLICT ("eventId") DO UPDATE SET "retryAt"=now();
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER omoshow_cover_change AFTER UPDATE OF media,"imageUrl",status OR DELETE ON "Event" FOR EACH ROW EXECUTE FUNCTION omoshow_queue_cover();
