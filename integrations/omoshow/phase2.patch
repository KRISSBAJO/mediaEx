@@ -0,0 +1,56 @@
+import { ConflictException, ServiceUnavailableException } from '@nestjs/common';
+import { config } from '../config';
+import type { PrismaService } from '../prisma.service';
+
+type Cover = {id:string; revisionId?:string};
+type Review = {revisionId:string; latest:{id:string;state:string}|null};
+type Ref = {generation:number;assetId:string|null;revisionId:string|null};
+export const governedCovers = () => Boolean(process.env.MEDIAEX_PUBLICATION_KEY);
+async function api<T>(path:string,key:string,method='GET',body?:unknown):Promise<T>{
+  let res:Response;
+  try {
+    res=await fetch(config.mediaexUrl+'/api/v1/'+path,{method,redirect:'error',signal:AbortSignal.timeout(5000),headers:{authorization:'Bearer '+key,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});
+  }catch{throw new ServiceUnavailableException('MediaEX is unavailable. The live cover is preserved.');}
+  if(!res.ok){
+    if(res.status===409||res.status===403)throw new ConflictException('MediaEX requires an available, approved version. Refresh the review before continuing.');
+    throw new ServiceUnavailableException('MediaEX returned '+res.status+' for the cover operation.');
+  }
+  return res.json() as Promise<T>;
+}
+export async function submitCover(id:string,eventId:string):Promise<string>{
+  const path='assets/'+id+'/review',key=config.mediaexApiKey;
+  const review=await api<Review>(path,key);
+  if(!review.latest || review.latest.state==='changes_requested'){
+    await api(path,key,'POST',{action:'submit',revisionId:review.revisionId,expectedEvent:review.latest?.id??null,comment:'Proposed cover for Omoshow event '+eventId});
+  }
+  return review.revisionId;
+}
+async function assign(eventId:string,slot:string,cover:Cover|null,reason:string){
+  const key=process.env.MEDIAEX_PUBLICATION_KEY;
+  if(!key)throw new ServiceUnavailableException('MediaEX publication is not configured.');
+  const path='references?'+new URLSearchParams({application:'omoshow',resource:'event:'+eventId,slot});
+  const before=await api<Ref>(path,key);
+  if(before.assetId===(cover?.id??null)&&before.revisionId===(cover?.revisionId??null))return;
+  await api(path,key,cover?'PUT':'DELETE',{assetId:cover?.id,revisionId:cover?.revisionId,expectedGeneration:before.generation,reason});
+}
+// Reserve the exact revision before committing the event change. Historical cover pins also keep rollback bytes stable.
+export async function pinCover(eventId:string,media:unknown,actorId:string){
+  const cover=Array.isArray(media)?media[0] as Cover|undefined:undefined;
+  if(!cover)return;
+  if(!cover.revisionId)throw new ConflictException('Resubmit the proposed cover to obtain its MediaEX revision.');
+  await assign(eventId,'version:'+cover.revisionId,cover,'Approved event edit by '+actorId);
+}
+export async function reconcileCover(db:PrismaService){
+  await db.$transaction(async tx=>{
+    const [job]=await tx.$queryRaw<Array<{eventId:string}>>`select "eventId" from omoshow_cover_sync where "retryAt"<=now() order by "retryAt" limit 1 for update skip locked`;
+    if(!job)return;
+    const event=await tx.event.findUnique({where:{id:job.eventId},select:{status:true,media:true}});
+    const cover=event?.status==='PUBLISHED'&&Array.isArray(event.media)?event.media[0] as Cover|null:null;
+    try{
+      await assign(job.eventId,'cover',cover?.revisionId?cover:null,'Reconcile committed event cover');
+      await tx.$executeRaw`delete from omoshow_cover_sync where "eventId"=${job.eventId}`;
+    }catch{
+      await tx.$executeRaw`update omoshow_cover_sync set "retryAt"=now()+interval '30 seconds' where "eventId"=${job.eventId}`;
+    }
+  },{timeout:15000});
+}
