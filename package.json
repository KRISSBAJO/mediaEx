{
  "name": "mediaex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "predev:backend": "npm run db:migrate",
    "dev:backend": "node --env-file-if-exists=.env.local --experimental-strip-types --watch backend/server.mts",
    "prestart:backend": "npm run db:migrate",
    "start:backend": "node --env-file-if-exists=.env.local --experimental-strip-types backend/server.mts",
    "start": "next start -p 3400",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings backend/migrate.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.26",
    "hls.js": "^1.7.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
